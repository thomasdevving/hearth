# Copy to .env.local (untracked, rule R10). All values come from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check → Apps → reCAPTCHA Enterprise site key for this web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional: an App Check debug token registered in the console (accepted for the submission).
VITE_APPCHECK_DEBUG_TOKEN=
# Cloud model used by Firebase AI Logic (Gemini Developer API backend).
VITE_GEMINI_MODEL=gemini-3.5-flash
# Optional: use the local emulators (firebase emulators:start) instead of the real project.
VITE_USE_EMULATORS=false
